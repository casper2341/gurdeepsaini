# Copy to .env.local to override. Both are optional — the defaults in
# app/data/profile.js and app/data/travel.js are the production URLs.
#
# No secrets belong in this project: every value here is public by definition
# (NEXT_PUBLIC_* is inlined into the client bundle at build time).

# Canonical URL of the portfolio. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://gurdeepsaini.com

# Canonical URL of the travel subdomain. No trailing slash.
NEXT_PUBLIC_TRAVEL_URL=https://travel.gurdeepsaini.com
